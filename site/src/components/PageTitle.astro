---
// Starlight's page title, plus a byline on pages that have a `date` (the articles): who wrote it and
// when it was published.
import Default from '@astrojs/starlight/components/PageTitle.astro';

import { isoDate, showDate } from '../lib/articles';

const { date, author } = Astro.locals.starlightRoute.entry.data;
---

<Default />
{
  date && (
    <p class="byline">
      {author && <span>{author}</span>}
      <time datetime={isoDate(date)}>{showDate(date)}</time>
    </p>
  )
}

<style>
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .byline span + time::before {
    content: '·';
    margin-inline-end: 0.75rem;
  }
</style>
