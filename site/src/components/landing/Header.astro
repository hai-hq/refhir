---
// Site header: the logo (a light and a reversed file, swapped by theme) and the links a visitor
// needs first. The in-page links hide on a phone, where the section order does the work.
---

<header class="site-header">
  <div class="wrap site-header__row">
    <a class="site-header__logo" href="/" aria-label="ReFHIR home">
      <img class="logo logo--light" src="/brand/refhir-logo.svg" alt="" width="116" height="26" />
      <img class="logo logo--dark" src="/brand/refhir-logo-reversed.svg" alt="" width="116" height="26" />
    </a>
    <nav class="site-header__nav" aria-label="Main">
      <a class="hide-sm" href="#how">How it works</a>
      <a class="hide-sm" href="#build">Build with it</a>
      <a class="hide-sm" href="#features">Features</a>
      <a class="hide-xxs" href="/docs/introduction/">Docs</a>
      <a class="hide-xs" href="https://github.com/hai-hq/refhir">GitHub</a>
      <a class="btn btn--primary btn--small" href="/docs/getting-started/">Get started</a>
    </nav>
  </div>
</header>
