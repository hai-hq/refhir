---
import Agents from '../components/landing/Agents.astro';
import Build from '../components/landing/Build.astro';
import Closer from '../components/landing/Closer.astro';
import Contrast from '../components/landing/Contrast.astro';
import Features from '../components/landing/Features.astro';
import Hero from '../components/landing/Hero.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import Playground from '../components/landing/Playground.astro';
import Ways from '../components/landing/Ways.astro';
import Landing from '../layouts/Landing.astro';

const title = 'ReFHIR: open-source FHIR server with live queries';
const description =
  'ReFHIR is an open-source FHIR server, written in Rust, that keeps query results live. Ask once, and the new answer arrives when the data changes.';
---

<Landing title={title} description={description}>
  <Hero />
  <Contrast />
  <Playground />
  <Ways />
  <HowItWorks />
  <Build />
  <Agents />
  <Features />
  <Closer />
</Landing>
